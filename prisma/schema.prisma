datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  tipo     String
  edad     Int?
}

model Impresora {
  id         Int     @id @default(autoincrement())
  nombre     String
  tipo       String
  imagen     String
  velocidad  Float
}

model Cotizacion {
  id                        Int     @id @default(autoincrement())
  nombre                    String
  link                      String
  presupuesto               Float
  tipo                      String
  tamano                    String
  estatus                   String
  idConfiguracionCalculadora Int?
  diseno                    String?
  postprocesado             String?
  marketingEntrega          String?
  comentarios               String?
  DescripcionCliente        String
}

model Utilizables {
  id              Int     @id @default(autoincrement())
  nombre          String
  cantidad        Float
  cantidadActual  Float
  tipo            String
  material        String
  costoDeCompra   String
}

model ConfiguracionCalculadora {
  id                   Int     @id @default(autoincrement())
  utilizablesId        Int
  impresoraId          Int
  costoPorTiempo       Float
  costoDiseno          Float
  costoPostprocesado   Float
  costoMarketingEntrega Float
  empleadoId           Int
}