datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  tipo     String
  edad     Int?
}

model Impresora {
  id              Int     @id @default(autoincrement())
  nombre          String
  tipo            String
  imagen          Bytes?
  velocidad       Float
  dimensiones     String?
  costoPorHora    String?
}

model Cotizacion {
  id                        Int     @id @default(autoincrement())
  nombre                    String
  link                      String
  presupuesto               Float
  tipo                      String
  tamano                    String
  estatus                   String
  idConfiguracionCalculadora Int?
  diseno                    String?
  postprocesado             String?
  marketingEntrega          String?
  comentarios               String?
  DescripcionCliente        String
  usoConsumible             Int?
  TiempoOperandoHora        Int?
}

model Utilizables {
  id              Int     @id @default(autoincrement())
  nombre          String
  cantidad        Float
  cantidadActual  Float
  tipo            String
  material        String
  costoDeCompra   String
  costoDeVenta    String?
  imagen          Bytes?
}

model ConfiguracionCalculadora {
  id                   Int     @id @default(autoincrement())
  utilizablesId        Int
  impresoraId          Int
  costoPorTiempo       Float
  costoDiseno          Float
  costoPostprocesado   Float
  costoMarketingEntrega Float
  empleadoId           Int
}

model Puesto{
  id                    Int     @id @default(autoincrement())
  nombre                String
  cuotaPorHora          String
  estatus               Int
  descripcion           String
}

model Ventas{
  id                    Int     @id @default(autoincrement())
  nombre                String?
  costoDiseno           Int?
  costoMarketingEntrega Int?
  costoPostprocesado    Int?
  costoConsumible       Int?
  costoImpresora        Int?
  costoTotal            Int?
}